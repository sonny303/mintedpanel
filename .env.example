# Supabase credentials used by src/integrations/supabase/externalClient.ts.
# Copy to .env for local development; set these vars in Vercel for deploys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Chrome extension ID for web-to-extension case handoff. Exactly 32
# lowercase characters in a-p. Set per environment; there is no fallback ID.
VITE_MINTED_EXTENSION_ID=

# Exact Work v2 launch for explicit (Form setup) portal configurations. "true"
# sends SET_ACTIVE_WORK from the case page; anything else keeps the legacy
# SET_ACTIVE_CASE launch. Production and staging builds set it in vercel.json.
VITE_ENABLE_EXACT_WORK_V2=

# Server-only SendGrid mailer (src/server/email/). Never VITE_-prefixed: these
# must not reach the browser bundle. Use a restricted key (Mail Send only).
# SENDGRID_FROM_EMAIL must be on Minted's SendGrid-authenticated domain.
# Sends deliver unless SENDGRID_SANDBOX is exactly "true" (SendGrid then
# validates without delivering). Set it to "true" locally if you don't want a
# local invite to send real mail.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_SANDBOX=

# Provider onboarding (docs/provider-onboarding/slice-1-invite-to-form.md).
# Server-only: APP_BASE_URL is the origin the invite email links to, e.g.
# https://staging.mintedpanel.com. Unset, the invite routes return 500.
APP_BASE_URL=

# Scheduled jobs (MINT-106, src/server/jobs/). Server-only. Vercel cron sends
# `Authorization: Bearer <CRON_SECRET>` to GET /api/jobs/<name> once this is
# set on the Vercel project. Use a random string of at least 16 characters
# with no whitespace (e.g. `openssl rand -hex 32`). Unset, empty or shorter,
# every /api/jobs call answers 503 and no job runs.
CRON_SECRET=
